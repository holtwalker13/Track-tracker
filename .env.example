DATABASE_URL="postgresql://sap:sap@localhost:5432/sap"
SESSION_SECRET="change-me-to-a-long-random-string"
APP_MODE="development"

# Railway: do not paste a sqlite file: URL.
# Add a PostgreSQL plugin and reference its DATABASE_URL onto the app service.
# APP_MODE="production"
# Optional override for demo logins (default rekcart):
# DEMO_PASSWORD="rekcart"

# iPhone shell (read only by `npm run mobile:sync`, never shipped in the web bundle).
# Staging HTTPS origin is the default device target. No path, query, or credentials.
CAPACITOR_SERVER_URL="https://your-staging-host.up.railway.app"
# Live reload against this Mac. Leave unset for simulator and iPhone builds.
# CAPACITOR_DEV_SERVER_URL="http://192.168.1.10:3847"
