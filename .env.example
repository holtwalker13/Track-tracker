DATABASE_URL="postgresql://sap:sap@localhost:5432/sap"
SESSION_SECRET="change-me-to-a-long-random-string"
APP_MODE="development"

# Railway: do not paste a sqlite file: URL.
# Add a PostgreSQL plugin and reference its DATABASE_URL onto the app service.
# APP_MODE="production"
# Optional override for demo logins (default rekcart):
# DEMO_PASSWORD="rekcart"

# iPhone shell (read only by `npm run mobile:sync`, never shipped in the web bundle).
# Xcode simulator: loads the site from this Mac. Start `npm run dev`, then `npm run mobile:sync`, then Run.
CAPACITOR_DEV_SERVER_URL="http://127.0.0.1:3847"
# Physical iPhone on the same Wi-Fi: use the Mac's LAN address instead, for example
# CAPACITOR_DEV_SERVER_URL="http://192.168.1.10:3847"
# Real staging host only. Leave this commented for local Xcode. Origin only, https, no path.
# CAPACITOR_SERVER_URL="https://your-real-host.up.railway.app"
