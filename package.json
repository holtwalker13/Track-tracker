{
  "name": "sap-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --hostname :: --port 3847",
    "build": "DATABASE_URL=${DATABASE_URL:-postgresql://sap:sap@127.0.0.1:5432/sap} prisma generate && next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import tsx --test src/lib/**/*.test.ts src/lib/*.test.ts",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:ensure-kendall": "tsx scripts/ensure-jhs-kendall.ts",
    "db:ensure-ty-crowden": "tsx scripts/ensure-jhs-ty-crowden.ts",
    "db:ensure-demo-class": "tsx scripts/ensure-demo-class-login.ts",
    "db:setup-track-fixtures": "tsx scripts/setup-demo-fixtures.ts",
    "db:sync-password": "tsx scripts/sync-demo-password.ts",
    "db:migrate-tenants": "tsx scripts/migrate-tenants.ts",
    "postinstall": "DATABASE_URL=${DATABASE_URL:-postgresql://sap:sap@127.0.0.1:5432/sap} prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.46.0",
    "next": "15.5.25",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "prisma": "5.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
